# Normalize line endings for text files, keep binary assets untouched.
* text=auto

# Unity text-serialized (YAML) assets: keep LF so diffs stay readable across machines.
*.meta          text
*.unity         text
*.prefab        text
*.asset         text
*.mat           text
*.anim          text
*.controller    text
*.overrideController text
*.physicMaterial text
*.physicsMaterial2D text
*.preset        text
*.spriteatlas   text
*.mask          text
*.shadergraph   text
*.shadersubgraph text
*.shader        text
*.compute       text
*.asmdef        text
*.asmref        text
*.inputactions  text
*.json          text
*.txt           text
*.md            text
*.cs            text diff=csharp
*.uxml          text
*.uss           text
*.hlsl          text
*.cginc         text
*.glslinc       text
*.xml           text

# Binary assets: never convert, never diff as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.psd           binary
*.tga           binary
*.tif           binary
*.tiff          binary
*.exr           binary
*.hdr           binary
*.bmp           binary
*.fbx           binary
*.FBX           binary
*.obj           binary
*.blend         binary
*.3ds           binary
*.max           binary
*.ma            binary
*.mb            binary
*.wav           binary
*.mp3           binary
*.ogg           binary
*.aif           binary
*.aiff          binary
*.ttf           binary
*.otf           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.a               binary
*.lib           binary
*.zip           binary
*.7z            binary
*.gz            binary
*.unitypackage  binary
*.apk           binary
*.aab           binary
*.bundle        binary
*.bytes         binary
